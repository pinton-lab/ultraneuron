$T = K_a\,|\varepsilon_{\mathrm{vol}}|$    & {{ "%.3e" | format(el.tension.peak) }} & {{ "%.3e" | format(el.tension.peak_brain) }} & {{ "%.3e" | format(el.tension.peak_skull) }} & N/m \\
