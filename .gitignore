# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtualenvs
.venv/
venv/
env/

# Editor / IDE
.vscode/
.idea/
*.swp
.claude/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# LaTeX build artifacts (at any depth under docs/)
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
docs/**/*.bbl
docs/**/*.blg
docs/**/*.fdb_latexmk
docs/**/*.fls
docs/**/*.synctex.gz
# Stray root-level pdflatex failure log
texput.log

# Simulation outputs — too large for git (1 GB+ files).
# Track via Zenodo or regenerate from scripts.
*.npy
*.npz
*.dat
# Intermediate FDTD run outputs (scratch run artifacts, logs, binary symlinks)
scripts/outputs/
docs/**/scripts/outputs/

# OS
.DS_Store
._*
Thumbs.db
.cache

# Local-only legacy submissions and reports (not pushed)
docs/archive/

# Manuscript artifacts live under docs/ and are not part of this repo.
# The framework, scripts, and validation-report pipeline are tracked at
# the repo root; the rendered paper (manuscript, supplementary, cover
# letter, references.bib, etc.) is hosted on arXiv.
docs/

# Manuscript figure staging (duplicates of tracked validation figures;
# the manuscript itself is hosted externally, see docs/ above).
paper/

# Per-run simulation data directories (regenerated by the user from scripts).
# Only the validation-report figures and small metadata under these trees
# are tracked; the raw .npy / .npz / .dat outputs are blocked above.
data/halle_caudate/txrx_0/
data/halle_bowl/txrx_0/
data/halle_transcranial/txrx_0/
data/halle_transcranial_cfl0p4/
data/halle_dacc/txrx_0/
data/halle_dcn/txrx_0/
# Transient build / run logs under per-run data dirs (not tracked artifacts).
data/**/*.log

# Large 3-D field dumps and animation renders (multi-GB; regenerate from
# scripts or host on Zenodo). The *.npy/*.npz/*.dat rule above does not cover
# these raw-float / video / frame-sequence formats.
*.f32
*.mp4
*.gif
# Raw time-reversal micro-CT working tree (>1 GB .f32 fields + frame PNGs)
data/tr_microct/
# Per-run 3-D animation frame directories staged under the validation reports
# (e.g. neuralanim/, pressanim/, shearanim/, tempanim/, wave3danim/, wave_frames/)
**/*anim/
**/wave_frames/
# Rendered validation-report PDFs (tens of MB each; regenerate from the report
# builders or host on Zenodo). Figure PDFs under figures/ stay tracked.
data/*/validation_report/validation_report_*.pdf

# Manuscript outputs (figures and LaTeX tables written by scripts/ for the paper).
# The manuscript is kept separate from the public code.
/figures/
/supplementary_figures/
/data/*.tex
/data/*/calcium/*.tex
/data/*/pre_*/
*.md
!/README.md
